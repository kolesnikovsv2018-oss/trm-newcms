{
  "name": "trm/newcms",
  "description": "NewCMS based on TRMEngine framework",
  "type": "library",
  "license": "proprietary",
  "authors": [
    {
      "name": "TRM",
      "email": "trm@mail.ru"
    }
  ],
  "require": {
    "php": ">=8.3.0",
    "trm/trmengine": "^1.0"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github-podvesnoi:kolesnikovsv2018-oss/trm-trmengine.git"
    }
  ],
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "NewCMS\\": ""
    },
    "files": [
      "Libs/GlobalConfig.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "NewCMS\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  }
}

